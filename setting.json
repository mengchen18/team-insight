{
  "embedding": {
    "provider": "openai",
    "model": "openai/text-embedding-3-small",
    "base_url": "https://openrouter.ai/api/v1",
    "api_keys": [
      "$EMBEDDING_API_KEY"
    ],
    "batch_size": 50,
    "dimensions": 1536
  },
  "lancedb": {
    "path": ".claude/team-insight/db",
    "table_name": "memories"
  },
  "retrieval": {
    "mode": "hybrid",
    "min_score": 0.30,
    "hard_min_score": 0.35,
    "length_norm_anchor": 500,
    "time_decay_half_life_days": 60,
    "mmr_similarity_threshold": 0.85,
    "default_limit": 5
  },
  "json_dir": ".claude/team-insight/json",
  "user": {
    "name": "auto"
  }
}